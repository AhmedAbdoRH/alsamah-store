# قاعدة البيانات المصدر (الحالية)
SOURCE_SUPABASE_URL=https://your-source-project.supabase.co
SOURCE_SUPABASE_KEY=your-source-service-role-key

# قاعدة البيانات الهدف (الجديدة)
TARGET_SUPABASE_URL=https://your-target-project.supabase.co
TARGET_SUPABASE_KEY=your-target-service-role-key

# Optional Cloudflare image proxy for production delivery
VITE_CLOUDFLARE_IMAGE_PROXY_ENABLED=true
VITE_CLOUDFLARE_IMAGE_PROXY_BASE_URL=https://your-domain.com
